[gd_scene format=3]

[ext_resource type="Script" path="res://player/player.gd" id="1_player"]
[ext_resource type="Script" path="res://health/health.gd" id="2_health"]
[ext_resource type="PackedScene" path="res://weapons/weapon.tscn" id="3_weapon"]
[ext_resource type="Resource" path="res://weapons/pistol.tres" id="4_pistol"]
[ext_resource type="PackedScene" path="res://hud/hud.tscn" id="5_hud"]
[ext_resource type="PackedScene" path="res://pause_menu/pause_menu.tscn" id="6_pause_menu"]
[ext_resource type="PackedScene" path="res://player/player_model.glb" id="7_model"]
[ext_resource type="Script" path="res://player/player_animator.gd" id="8_animator"]
[ext_resource type="Script" path="res://economy/wallet.gd" id="9_wallet"]
[ext_resource type="Script" path="res://player/melee.gd" id="10_melee"]
[ext_resource type="PackedScene" path="res://player/punch_view.tscn" id="11_punch_view"]

[sub_resource type="CapsuleShape3D" id="capsule"]
radius = 0.35
height = 1.8

[node name="Player" type="CharacterBody3D" groups=["player"]]
script = ExtResource("1_player")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
position = Vector3(0, 0.9, 0)
shape = SubResource("capsule")

[node name="Body" parent="." instance=ExtResource("7_model")]

[node name="Animator" type="Node" parent="."]
script = ExtResource("8_animator")

[node name="Head" type="Node3D" parent="."]
position = Vector3(0, 1.6, 0)

[node name="Camera3D" type="Camera3D" parent="Head"]
fov = 80.0
current = true

[node name="Weapon" parent="Head/Camera3D" instance=ExtResource("3_weapon")]
data = ExtResource("4_pistol")

[node name="PunchView" parent="Head/Camera3D" instance=ExtResource("11_punch_view")]

[node name="Health" type="Node" parent="."]
script = ExtResource("2_health")

[node name="Wallet" type="Node" parent="."]
script = ExtResource("9_wallet")

[node name="Melee" type="Node" parent="."]
script = ExtResource("10_melee")

[node name="Hud" parent="." node_paths=PackedStringArray("health", "weapon", "wallet") instance=ExtResource("5_hud")]
health = NodePath("../Health")
weapon = NodePath("../Head/Camera3D/Weapon")
wallet = NodePath("../Wallet")

[node name="PauseMenu" parent="." instance=ExtResource("6_pause_menu")]
