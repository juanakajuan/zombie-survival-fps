[gd_resource type="Theme" format=3]

[sub_resource type="SystemFont" id="system_font"]
font_names = PackedStringArray("Barlow Condensed", "Oswald", "Roboto Condensed", "Fira Sans Condensed", "Open Sans Condensed", "Arial Narrow", "sans-serif")
font_weight = 800
font_stretch = 75

[sub_resource type="FontVariation" id="slanted"]
base_font = SubResource("system_font")
variation_embolden = 0.4
variation_transform = Transform2D(1, 0, 0.22, 1, 0, 0)

[resource]
default_font = SubResource("slanted")
default_font_size = 20
Label/colors/font_color = Color(1, 1, 1, 1)
Label/colors/font_shadow_color = Color(0, 0, 0, 0.55)
Label/constants/shadow_offset_x = 2
Label/constants/shadow_offset_y = 2
