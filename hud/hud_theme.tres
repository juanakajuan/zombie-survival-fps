[gd_resource type="Theme" format=3]

[sub_resource type="SystemFont" id="system_font"]
font_names = PackedStringArray("Barlow Condensed", "Oswald", "Roboto Condensed", "Fira Sans Condensed", "Open Sans Condensed", "Arial Narrow", "sans-serif")
font_weight = 800
font_stretch = 75

[sub_resource type="FontVariation" id="slanted"]
base_font = SubResource("system_font")
variation_embolden = 0.4
variation_transform = Transform2D(1, 0, 0.22, 1, 0, 0)

[sub_resource type="StyleBoxFlat" id="button_normal"]
content_margin_left = 18.0
content_margin_top = 6.0
content_margin_right = 18.0
content_margin_bottom = 6.0
bg_color = Color(0.12, 0.12, 0.13, 0.9)
skew = Vector2(0.15, 0)

[sub_resource type="StyleBoxFlat" id="button_hover"]
content_margin_left = 18.0
content_margin_top = 6.0
content_margin_right = 18.0
content_margin_bottom = 6.0
bg_color = Color(1, 1, 1, 0.95)
skew = Vector2(0.15, 0)

[sub_resource type="StyleBoxFlat" id="button_pressed"]
content_margin_left = 18.0
content_margin_top = 6.0
content_margin_right = 18.0
content_margin_bottom = 6.0
bg_color = Color(1, 0.9, 0, 1)
skew = Vector2(0.15, 0)

[sub_resource type="StyleBoxFlat" id="button_focus"]
draw_center = false
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(1, 0.9, 0, 1)
skew = Vector2(0.15, 0)

[sub_resource type="StyleBoxFlat" id="slider_track"]
content_margin_top = 3.0
content_margin_bottom = 3.0
bg_color = Color(1, 1, 1, 0.2)

[sub_resource type="StyleBoxFlat" id="slider_fill"]
content_margin_top = 3.0
content_margin_bottom = 3.0
bg_color = Color(1, 0.9, 0, 1)

[resource]
default_font = SubResource("slanted")
default_font_size = 20
Label/colors/font_color = Color(1, 1, 1, 1)
Label/colors/font_shadow_color = Color(0, 0, 0, 0.55)
Label/constants/shadow_offset_x = 2
Label/constants/shadow_offset_y = 2
InkLabel/base_type = &"Label"
InkLabel/colors/font_outline_color = Color(0.06, 0.04, 0.05, 1)
InkLabel/colors/font_shadow_color = Color(0, 0, 0, 0)
InkLabel/constants/outline_size = 8
Button/colors/font_color = Color(1, 1, 1, 1)
Button/colors/font_focus_color = Color(1, 1, 1, 1)
Button/colors/font_hover_color = Color(0.08, 0.08, 0.08, 1)
Button/colors/font_hover_pressed_color = Color(0.08, 0.08, 0.08, 1)
Button/colors/font_pressed_color = Color(0.08, 0.08, 0.08, 1)
Button/styles/focus = SubResource("button_focus")
Button/styles/hover = SubResource("button_hover")
Button/styles/hover_pressed = SubResource("button_pressed")
Button/styles/normal = SubResource("button_normal")
Button/styles/pressed = SubResource("button_pressed")
HSlider/styles/grabber_area = SubResource("slider_fill")
HSlider/styles/grabber_area_highlight = SubResource("slider_fill")
HSlider/styles/slider = SubResource("slider_track")
