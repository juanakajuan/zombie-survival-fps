# Machine gun: get points from the debug menu, walk to the machine gun wall buy on the large crate, buy it, hold fire, reload it.
expect hud.weapon PISTOL
debug +5000 POINTS
face 4.1 0
hold move_forward
wait 180
release move_forward
wait 20
face 90 -5
hold move_forward
until hud.prompt_visible true 300
release move_forward
wait 10
expect hud.prompt E BUY MACHINE GUN 2500
shot 01-wall-buy
tap interact
wait 5
expect hud.points 2500
expect hud.weapon MACHINE GUN
expect hud.ammo 100 / 300
face 0 0
wait 40
shot 02-machine-gun
hold fire
wait 60
shot 03-firing
release fire
expect_not hud.ammo 100 / 300
state 03-fired
hold aim
wait 30
shot 04-aimed
release aim
tap reload
wait 120
shot 05-reload
until hud.reloading false 300
expect hud.ammo 100 / 291
state 05-reloaded
