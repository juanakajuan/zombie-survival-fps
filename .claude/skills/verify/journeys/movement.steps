# Movement and look: walk, sprint, jump, turn with the mouse, pause with Esc, resume with Esc and take the mouse back.
expect player.position 0.0 0.0 6.0
expect mouse.mode captured
hold move_forward
wait 30
release move_forward
wait 30
state 01-after-walk
expect_not player.position 0.0 0.0 6.0
hold sprint
hold move_forward
wait 30
release move_forward
release sprint
wait 30
state 02-after-sprint
tap jump
wait 10
state 03-in-jump
shot 03-in-jump
look 200 0
expect player.yaw_deg -29
shot 04-after-look
look 0 -2000
expect player.pitch_deg 89
face 0 0
expect player.yaw_deg 0
expect player.pitch_deg 0
key F5
expect player.third_person true
shot 04b-third-person
key F5
expect player.third_person false
key Escape
expect mouse.mode visible
expect game.paused true
expect pause_menu.open true
shot 05-paused
key Escape
expect game.paused false
expect pause_menu.open false
expect mouse.mode captured
wait 12
expect hud.ammo 12 / 48
state 06-resumed
