# Weapon box: get 1000 points and a break from the debug menu, walk to the box behind the start, use it, see the weapon over it, take it with E.
expect box.position 0.0 0.0 9.5
expect box.offer
debug +500 POINTS
debug +500 POINTS
debug KILL ALL ZOMBIES
expect hud.break true
expect zombies.alive 0
expect hud.points 1000
state 01-earned
face 180 0
hold move_forward
wait 25
release move_forward
wait 30
look 0 260
until hud.prompt_visible true 60
expect hud.prompt E WEAPON BOX 950
state 02-prompt
shot 02-prompt
tap interact
wait 5
expect hud.points 50
expect_not box.offer
expect_not hud.prompt E WEAPON BOX 950
look 0 -200
wait 5
state 03-offer
shot 03-offer
look 0 200
wait 5
tap interact
wait 5
expect_not hud.weapon PISTOL
expect box.offer
expect hud.prompt E WEAPON BOX 950
wait 40
state 04-taken
shot 04-taken
