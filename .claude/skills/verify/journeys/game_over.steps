# Player death, game over, restart: stand still until zombies kill the player, read the screen, press Enter.
tap restart
wait 10
expect game_over.visible false
expect player.position 0.0 0.0 6.0
until zombies.alive 4 300
until player.downed true 3600
expect player.dead false
state 00-downed
shot 00-downed
until game_over.visible true 1200
expect player.dead true
expect player.downed false
expect hud.health 0
expect game_over.text You reached round 1
expect mouse.mode visible
state 01-game-over
shot 01-game-over
tap move_forward
tap fire
expect hud.ammo 12 / 48
tap restart
wait 10
expect game_over.visible false
expect player.dead false
expect hud.health 100
expect hud.ammo 12 / 48
expect hud.round 1
expect player.position 0.0 0.0 6.0
expect mouse.mode captured
state 02-restarted
shot 02-restarted
