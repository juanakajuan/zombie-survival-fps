# Weapons: get 1500 points from the debug menu, buy the SMG at the weapon station, switch with 1, 2 and the wheel, fire the SMG by holding fire, see that a full SMG reserve buys nothing.
# The debug points and GOD MODE only set up the buy; journeys/economy.steps proves how points are earned.
debug GOD MODE
debug +500 POINTS
debug +500 POINTS
debug +500 POINTS
expect hud.weapon PISTOL
expect hud.ammo 12 / 48
expect hud.points 1500
state 01-points
shot 01-pistol
face -53 0
hold move_forward
wait 30
release move_forward
wait 30
look 0 220
until hud.prompt_visible true 60
expect hud.prompt E BUY SMG 1000
state 02-prompt
shot 02-prompt
tap interact
wait 5
expect hud.points 500
expect hud.weapon SMG
expect hud.ammo 30 / 150
wait 40
state 03-bought
shot 03-smg
expect hud.prompt E BUY SMG AMMO 300
tap interact
wait 5
expect hud.points 500
tap weapon_1
wait 5
expect hud.weapon PISTOL
expect_not hud.ammo 30 / 150
wait 40
state 04-key-1
shot 04-pistol
tap weapon_2
wait 5
expect hud.weapon SMG
expect hud.ammo 30 / 150
tap weapon_next
wait 5
expect hud.weapon PISTOL
tap weapon_previous
wait 5
expect hud.weapon SMG
wait 40
look 0 -400
hold fire
wait 30
shot 05-firing
release fire
expect_not hud.ammo 30 / 150
expect_not hud.ammo 29 / 150
state 05-fired
tap weapon_1
wait 5
expect hud.weapon PISTOL
tap fire
wait 12
expect hud.weapon PISTOL
state 06-pistol-fired
