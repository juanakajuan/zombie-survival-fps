# Runners: skip to round 4 with the debug menu and see that no zombie runs, then go to round 5, where 6 of its 24 zombies run in red shirts. 3 of them are among the first 12 to spawn.
# The debug KILL ALL ZOMBIES and SKIP BREAK buttons only set up the late round. The proof is the runners that round 5 spawns.
debug GOD MODE
expect hud.round 1
debug KILL ALL ZOMBIES
until hud.break true 60
debug SKIP BREAK
until hud.round 2 60
debug KILL ALL ZOMBIES
until hud.break true 60
debug SKIP BREAK
until hud.round 3 60
debug KILL ALL ZOMBIES
until hud.break true 60
debug SKIP BREAK
until hud.round 4 60
until zombies.alive 10 900
expect hud.objective 18 LEFT
expect zombies.runners 0
wait 60
aim
state 00-round-four
shot 00-round-four
debug KILL ALL ZOMBIES
until hud.break true 60
debug SKIP BREAK
until hud.round 5 60
expect hud.objective 24 LEFT
until zombies.alive 12 900
expect zombies.runners 3
expect hud.objective 24 LEFT
wait 60
aim
state 01-round-five
shot 01-round-five
