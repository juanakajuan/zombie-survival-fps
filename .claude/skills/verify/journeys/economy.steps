# Economy: earn points by clearing round 1, walk to the ammo station, see the prompt, press E, and check the purchase.
expect hud.points 0
expect hud.ammo 12 / 48
expect hud.prompt_visible false
until zombies.alive 6 600
fight_until hud.break true 3600
expect zombies.alive 0
expect hud.points 720
expect_not hud.ammo 12 / 48
state 01-earned
shot 01-earned
face 0 0
expect player.yaw_deg 0
look 628 0
hold move_forward
wait 30
release move_forward
wait 30
look 0 240
until hud.prompt_visible true 60
expect hud.prompt E BUY AMMO 250
state 02-prompt
shot 02-prompt
tap interact
wait 5
expect hud.points 470
state 03-bought
shot 03-bought
tap reload
wait 90
tap interact
wait 5
expect hud.points 220
expect hud.ammo 12 / 48
state 04-full
shot 04-full
tap interact
wait 5
expect hud.points 220
look 0 -400
wait 5
expect hud.prompt_visible false
state 05-looked-away
