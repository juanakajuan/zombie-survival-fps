# Upgrade: get points from the debug menu, buy the room door, turn on the power, upgrade the pistol (the effect is in upgrade_effect.steps).
expect power.on false
expect hud.perks
expect hud.max_health 100
key F1
key Tab
key Tab
key Enter
key Enter
key Tab
key Tab
key Tab
key Tab
key Enter
key F1
expect hud.points 10000
expect zombies.alive 0
face 143 0
hold move_forward
wait 70
release move_forward
wait 3
face -90 0
hold move_forward
wait 255
release move_forward
wait 20
face 180 0
until hud.prompt_visible true 60
tap interact
wait 10
expect doors.open 1
hold move_forward
wait 150
release move_forward
wait 20
face -59 -9
until hud.prompt_visible true 60
expect hud.prompt E TURN ON POWER
tap interact
wait 10
expect power.on true
until hud.break false 600
wait 30
key F1
key Tab
key Tab
key Tab
key Tab
key Tab
key Tab
key Enter
key F1
expect zombies.alive 0
face 0 0
hold move_forward
wait 150
release move_forward
wait 20
face 90 0
hold move_forward
wait 190
release move_forward
wait 20
face 0 0
hold move_forward
wait 110
release move_forward
wait 20
face -90 -15
until hud.prompt_visible true 60
expect hud.weapon PISTOL
expect hud.ammo 12 / 48
expect hud.prompt E BUY UPGRADE PISTOL 5000
state 01-machine
shot 01-machine
tap interact
wait 30
expect hud.points 4250
expect hud.weapon PISTOL+
expect hud.ammo 18 / 108
expect hud.prompt E BUY UPGRADE PISTOL+ 2500
state 02-upgraded
shot 02-upgraded
