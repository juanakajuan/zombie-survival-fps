# Melee: punch the first zombie that comes close with V until it dies, while the player is alive.
expect hud.points 0
until zombies.alive 4 300
punch_until hud.objective 3 LEFT 900
state 01-killed
shot 01-killed
expect hud.points 80
expect player.dead false
aim
tap melee
wait 5
shot 02-mid-swing
wait 40
expect player.dead false
