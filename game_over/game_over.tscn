[gd_scene format=3]

[ext_resource type="Script" path="res://game_over/game_over.gd" id="1_game_over"]
[ext_resource type="Theme" path="res://hud/hud_theme.tres" id="2_theme"]

[node name="GameOver" type="CanvasLayer"]
layer = 10
script = ExtResource("1_game_over")

[node name="Dim" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.1, 0.08, 0.07, 0.7)

[node name="Center" type="CenterContainer" parent="."]
anchors_preset = 15
theme = ExtResource("2_theme")
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="Center"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"GameOverPanel"

[node name="VBox" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Center/Panel/VBox"]
layout_mode = 2
theme_type_variation = &"MenuTitle"
theme_override_font_sizes/font_size = 96
text = "GAME OVER"
horizontal_alignment = 1

[node name="RoundLabel" type="Label" parent="Center/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 36
text = "You reached round 1"
horizontal_alignment = 1

[node name="Hint" type="Label" parent="Center/Panel/VBox"]
layout_mode = 2
theme_type_variation = &"MenuHint"
theme_override_font_sizes/font_size = 22
text = "Press Enter to restart"
horizontal_alignment = 1
